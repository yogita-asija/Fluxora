# Copy to .env and replace every "change-me-*" value:
#
#     python scripts/init_env.py        # creates .env with random secrets (recommended)
#
# .env is git-ignored. Never commit real credentials.
# Use URL-safe passwords (letters/digits): they are embedded in connection URLs.

# --- General -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_REPLICAS=2
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=orderflow

# --- Redis / RabbitMQ ----------------------------------------------------
REDIS_PASSWORD=change-me-redis
RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=change-me-rabbitmq

# --- Grafana -------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Host ports (all bound to 127.0.0.1) ---------------------------------
HTTP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Backend running on the host (make dev-backend / migrate-local / seed-local) ---
# Docker Compose ignores this: containers get their own DATABASE_URL built from the
# POSTGRES_* values above. Keep the password identical to POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://orderflow:change-me-postgres@localhost:5432/orderflow
