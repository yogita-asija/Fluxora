# Copy to .env and replace every "change-me-*" value:
#
#     python scripts/init_env.py        # creates .env with random secrets (recommended)
#
# .env is git-ignored. Never commit real credentials.
# Use URL-safe passwords (letters/digits): they are embedded in connection URLs.

# --- General -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_REPLICAS=2
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=orderflow

# --- Authentication ------------------------------------------------------
# Signs login tokens. Must be 32+ characters; the app refuses to start with a placeholder.
JWT_SECRET_KEY=change-me-jwt
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Passwords for the demo accounts created by the seed command (admin@orderflow.local and
# customer@orderflow.local). Use 10+ characters. If left empty, random ones are printed once.
SEED_ADMIN_PASSWORD=change-me-seedadmin
SEED_CUSTOMER_PASSWORD=change-me-seedcustomer

# --- Redis / RabbitMQ ----------------------------------------------------
REDIS_PASSWORD=change-me-redis
RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=change-me-rabbitmq

# --- Grafana -------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Host ports (all bound to 127.0.0.1) ---------------------------------
HTTP_PORT=8080
# Non-default host port: Windows often reserves 5432 (Hyper-V/WinNAT) or a local Postgres uses it.
POSTGRES_PORT=15432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Backend running on the host (make dev-backend / migrate-local / seed-local) ---
# Docker Compose ignores this: containers get their own DATABASE_URL built from the
# POSTGRES_* values above. Keep the password identical to POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://orderflow:change-me-postgres@localhost:15432/orderflow
